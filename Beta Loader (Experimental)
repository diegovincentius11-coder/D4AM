local TextChatService = game:GetService("TextChatService")
local chatEnabled = false
local chatMessage = ""
local chatCooldown = 30

local chatInput = Tab:CreateInput({
   Name = "Insert text for Chat Automation",
   CurrentValue = "",
   PlaceholderText = "Example : Hai Sayang",
   RemoveTextAfterFocusLost = false,
   Flag = "Input1",
   Callback = function(Text)
      -- The function that takes place when the input is changed
      -- The variable (Text) is a string for the value in the text box
      chatMessage = Text
   end,
})

local cooldownInput = Tab:CreateInput({
   Name = "Cooldown Chat Automation",
   CurrentValue = "30",
   PlaceholderText = "put in seconds",
   RemoveTextAfterFocusLost = false,
   Flag = "Input2",
   Callback = function(CD)
      -- The function that takes place when the input is changed
      -- The variable (CD) is a string for the value in the text box
      local value = tonumber(CD)
      if value and value >= 1 then
         chatCooldown = value
      else
         chatCooldown = 30
      end
   end,
})

local Toggle = Tab:CreateToggle({
   Name = "Chat Automation",
   CurrentValue = false,
   Flag = "Toggle2", -- A flag is the identifier for the configuration file; make sure every element has a different flag if you're using configuration saving to ensure no overlaps
   Callback = function(Value)
      chatEnabled = Value
      if not chatEnabled then
         return
      end

      task.spawn(function()
         while chatEnabled do
            if chatMessage ~= "" then
               pcall(function()
                  local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
                  if channel then
                     channel:SendAsync(chatMessage)
                  else
                     local Players = game:GetService("Players")
                     local player = Players.LocalPlayer
                     if player then
                        player:Chat(chatMessage)
                     end
                  end
               end)
            end

            task.wait(chatCooldown)
         end
      end)
   end,
})
