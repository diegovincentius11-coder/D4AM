--// =========================
--// DETECT PET TYPE
--// =========================

local function GetPetType(petData)

    local isNeon = false
    local isMega = false

    if petData.properties then

        if petData.properties.neon then
            isNeon = true
        end

        if petData.properties.mega_neon then
            isMega = true
        end
    end

    if isMega then
        return "mega"
    elseif isNeon then
        return "neon"
    else
        return "normal"
    end
end

--// =========================
--// GET PET VALUE
--// =========================

local function GetPetValue(petName, petType)

    if PetValues[petName] then

        return PetValues[petName][petType] or 0
    end

    return 0
end

--// =========================
--// CALCULATE TOTAL VALUE
--// =========================

local function CalculateTradeValue(items)

    local total = 0
    local count = 0

    for _,petData in pairs(items) do

        count += 1

        local petName = petData.kind

        local petType = GetPetType(petData)

        local value = GetPetValue(petName, petType)

        total += value

        print("PET:", petName, petType, value)
    end

    return total, count
end

--// =========================
--// TRADE SYSTEM
--// =========================

local TradeApp

pcall(function()
    TradeApp = require(
        ReplicatedStorage.ClientModules.Core.ClientData
    )
end)

--// =========================
--// AUTO TRADE HANDLER
--// =========================

local function HandleTrade(tradeData)

    if not tradeData then
        return
    end

    local otherUser = nil

    for username,data in pairs(tradeData) do

        if username ~= LocalPlayer.Name then
            otherUser = data
            break
        end
    end

    if not otherUser then
        return
    end

    local items = otherUser.offer or {}

    local totalValue, petCount = CalculateTradeValue(items)

    print("TOTAL VALUE:", totalValue)
    print("PET COUNT:", petCount)

    -- Reject jika lebih dari 2 pet
    if petCount > MAX_PETS then

        print("Trade ditolak: terlalu banyak pet")

        pcall(function()
            ReplicatedStorage.API["TradeAPI/DeclineTrade"]:FireServer()
        end)

        return
    end

    -- Accept jika value >= 5
    if totalValue >= REQUIRED_VALUE then

        print("Trade diterima")

        pcall(function()

            ReplicatedStorage.API["TradeAPI/AcceptTrade"]:FireServer()

            task.wait(2)

            ReplicatedStorage.API["TradeAPI/ConfirmTrade"]:FireServer()
        end)

    else

        print("Trade ditolak: value kurang")

        pcall(function()
            ReplicatedStorage.API["TradeAPI/DeclineTrade"]:FireServer()
        end)
    end
end

--// =========================
--// LISTEN TRADE CHANGES
--// =========================

spawn(function()

    while true do

        task.wait(1)

        pcall(function()

            local tradeData = TradeApp.get_data()["trade"]

            if tradeData and tradeData.participants then

                HandleTrade(tradeData.participants)
            end
        end)
    end
end)

