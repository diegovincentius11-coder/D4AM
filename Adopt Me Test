--// =========================
--// MAGIC DOOR PLACE
--// =========================

local function PlaceMagicDoor()
    pcall(function()

        local backpack = LocalPlayer:WaitForChild("Backpack")

        for _,tool in pairs(backpack:GetChildren()) do
            if string.find(tool.Name:lower(), "magic door") then

                LocalPlayer.Character.Humanoid:EquipTool(tool)

                task.wait(1)

                tool:Activate()

                print("Magic Door dipasang")
            end
        end
    end)
end

